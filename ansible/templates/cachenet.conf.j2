server {
    listen 80{{ ' default_server' if ansible_hostname is defined else '' }};
    {% if domain_name is defined %}
    server_name {{ domain_name }} www.{{ domain_name }};
    {% else %}
    server_name _;
    {% endif %}
    
    # Logging
    access_log /var/log/nginx/{{ domain_name | default('cachenet') }}-access.log combined;
    error_log /var/log/nginx/{{ domain_name | default('cachenet') }}-error.log warn;
    
    # Security headers
    add_header X-Cache-Status $upstream_cache_status always;
    add_header X-Edge-Server {{ ansible_hostname | default('edge') }} always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    
    # Cache configuration
    proxy_cache cachenet;
    proxy_cache_background_update on;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_lock on;
    proxy_cache_revalidate on;
    proxy_cache_min_uses 1;
    
    # Cache key with domain support
    {% if domain_name is defined %}
    proxy_cache_key "{{ domain_name }}$scheme$request_method$host$request_uri";
    {% else %}
    proxy_cache_key "$scheme$request_method$host$request_uri";
    {% endif %}
    
    # Origin server variable
    {% if origin_server is defined %}
    set $origin_server {{ origin_server }};
    {% else %}
    set $origin_server http://127.0.0.1:8080;
    {% endif %}
    
    # Cache TTL variable
    {% if cache_ttl is defined %}
    set $cache_ttl {{ cache_ttl }};
    {% else %}
    set $cache_ttl 3600;
    {% endif %}
    
    # Static assets - long cache
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|pdf|zip|tar|bz2|gz|rar|7z|mp4|mp3|avi|mov|wmv|flv|webm|ogg)$ {
        proxy_pass $origin_server;
        proxy_cache_valid 200 206 30d;
        proxy_cache_valid 301 302 1h;
        proxy_cache_valid 404 1m;
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Edge-Server {{ ansible_hostname | default('edge') }} always;
        
        # Proxy settings for static assets
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeouts for static assets
        proxy_connect_timeout 5s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
    }
    
    # HTML pages - medium cache
    location ~* \.(html|htm)$ {
        proxy_pass $origin_server;
        proxy_cache_valid 200 206 $cache_ttl;
        proxy_cache_valid 301 302 1h;
        proxy_cache_valid 404 5m;
        expires $cache_ttl;
        add_header Cache-Control "public";
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Edge-Server {{ ansible_hostname | default('edge') }} always;
        
        # Proxy settings
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Timeouts
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
    }
    
    # API endpoints - short cache
    location ~* ^/api/ {
        proxy_pass $origin_server;
        proxy_cache_valid 200 206 5m;
        proxy_cache_valid 301 302 1h;
        proxy_cache_valid 404 1m;
        expires 5m;
        add_header Cache-Control "public, max-age=300";
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Edge-Server {{ ansible_hostname | default('edge') }} always;
        
        # Proxy settings for API
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Longer timeouts for API
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
    
    # WordPress admin - no cache
    location ~* ^/wp-(admin|login|cron) {
        proxy_pass $origin_server;
        proxy_cache off;
        add_header Cache-Control "private, no-cache, no-store, must-revalidate";
        add_header X-Cache-Status "BYPASS" always;
        add_header X-Edge-Server {{ ansible_hostname | default('edge') }} always;
        
        # Proxy settings
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Extended timeouts for admin
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
    
    # Default location - dynamic content
    location / {
        proxy_pass $origin_server;
        proxy_cache_valid 200 206 $cache_ttl;
        proxy_cache_valid 301 302 1h;
        proxy_cache_valid 404 5m;
        proxy_cache_valid any 1m;
        expires $cache_ttl;
        add_header Cache-Control "public, max-age=$cache_ttl";
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Edge-Server {{ ansible_hostname | default('edge') }} always;
        
        # Proxy settings
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Bypass cache for certain parameters
        set $no_cache 0;
        if ($request_method = POST) {
            set $no_cache 1;
        }
        if ($query_string ~ "nocache|no-cache") {
            set $no_cache 1;
        }
        if ($http_cookie ~ "comment_author|wordpress_[a-f0-9]+|wp-postpass|wordpress_logged_in") {
            set $no_cache 1;
        }
        proxy_cache_bypass $no_cache;
        proxy_no_cache $no_cache;
        
        # Timeouts
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;
        
        # Buffer settings
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
    }
    
    # Cache purge endpoint
    location /purge {
        limit_req zone=purge burst=5 nodelay;
        
        # Allow only POST requests
        if ($request_method != POST) {
            return 405 "Method not allowed";
        }
        
        # Get the URL to purge from request body or parameter
        set $purge_url $request_uri;
        if ($arg_url) {
            set $purge_url $arg_url;
        }
        
        # Purge cache for specific URL
        {% if domain_name is defined %}
        proxy_cache_purge cachenet "{{ domain_name }}$scheme$request_method$host$purge_url";
        {% else %}
        proxy_cache_purge cachenet "$scheme$request_method$host$purge_url";
        {% endif %}
        
        return 200 "Cache purged for $host$purge_url\n";
        add_header Content-Type text/plain;
    }
    
    # Purge all cache for domain
    location /purge-all {
        limit_req zone=purge burst=5 nodelay;
        
        # Allow only POST requests
        if ($request_method != POST) {
            return 405 "Method not allowed";
        }
        
        # This would require custom Nginx module or external script
        # For now, return instruction
        return 200 "To purge all cache, use: find /var/cache/nginx -name '*{{ domain_name | default('*') }}*' -delete\n";
        add_header Content-Type text/plain;
    }
    
    # Health check for load balancer
    location /health {
        access_log off;
        return 200 "OK - Edge Node {{ ansible_hostname | default('edge') }} - {{ ansible_default_ipv4.address | default('unknown') }}\nStatus: {{ 'active' if cdn_enabled | default(true) else 'disabled' }}\nCache: enabled\nSSL: {{ 'enabled' if ssl_enabled | default(false) else 'disabled' }}\nOrigin: {{ origin_server | default('not configured') }}\nTimestamp: $time_iso8601\n";
        add_header Content-Type text/plain;
        add_header X-Edge-Server {{ ansible_hostname | default('edge') }};
    }
    
    # Metrics endpoint for monitoring
    location /metrics {
        access_log off;
        stub_status on;
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
    }
    
    # Deny access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
        return 404;
    }
    
    # Deny access to backup and temporary files
    location ~ ~$ {
        deny all;
        access_log off;
        log_not_found off;
        return 404;
    }
    
    # Deny access to configuration files
    location ~ \.(conf|ini|log|sql)$ {
        deny all;
        access_log off;
        log_not_found off;
        return 404;
    }
}

{% if ssl_enabled is defined and ssl_enabled and domain_name is defined %}
# SSL/HTTPS configuration
server {
    listen 443 ssl http2;
    server_name {{ domain_name }} www.{{ domain_name }};
    
    # SSL certificates
    ssl_certificate /etc/letsencrypt/live/{{ domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain_name }}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/{{ domain_name }}/chain.pem;
    
    # SSL optimization
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;
    
    # Modern SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    
    # HSTS (HTTP Strict Transport Security)
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    
    # OCSP stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;
    
    # Include all the same location blocks as HTTP server
    # (Copy all location blocks from above)
    include /etc/nginx/conf.d/{{ domain_name }}-locations.conf;
}

# HTTP to HTTPS redirect
server {
    listen 80;
    server_name {{ domain_name }} www.{{ domain_name }};
    
    # Redirect all HTTP traffic to HTTPS
    return 301 https://$server_name$request_uri;
}
{% endif %}