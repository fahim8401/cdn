# XenCDN v8.2 Enterprise Platform Environment Configuration
# Replace all placeholder values with your actual credentials

# Database Configuration
DATABASE_URL=postgresql://xencdn:your-secure-db-password@db:5432/xencdn
POSTGRES_DB=xencdn
POSTGRES_USER=xencdn
POSTGRES_PASSWORD=your-secure-db-password

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# JWT Secret Key - Generate a new one for production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production-xyz789

# PowerDNS Configuration
PDNS_API_KEY=your-powerdns-api-key-abc123456789
PDNS_API_URL=http://powerdns:8081/api/v1/servers/localhost

# MinIO S3 Configuration
MINIO_ROOT_USER=xencdn-admin
MINIO_ROOT_PASSWORD=your-minio-secure-password-456
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=xencdn-ssl-certs

# Cloud Provider APIs for Manual Edge Node Addition
DIGITALOCEAN_API_TOKEN=your-digitalocean-api-token-dop_v1_abc123
LINODE_API_TOKEN=your-linode-api-token-lish_abc123
VULTR_API_KEY=your-vultr-api-key-vultr_abc123
HETZNER_API_TOKEN=your-hetzner-api-token-hetzner_abc123

# MaxMind GeoIP Database
MAXMIND_LICENSE_KEY=your-maxmind-license-key-abc123
MAXMIND_ACCOUNT_ID=your-maxmind-account-id-123456

# ACME.sh Configuration for SSL
ACME_EMAIL=ssl@cdn.yourcompany.com
ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Domain Configuration for XenCDN v8.2
HOMEPAGE_DOMAIN=xencdn.com
API_DOMAIN=api.xencdn.com
ADMIN_DOMAIN=admin.xencdn.com
CLIENT_PORTAL_DOMAIN=client.xencdn.com
ISP_PORTAL_DOMAIN=isp.xencdn.com
SPEED_TEST_DOMAIN=speedtest.xencdn.com

# DNS Server Configuration
DNS_SERVER_NAME=ns1.xencdn.com
DNS_SERVER_NAME2=ns2.xencdn.com

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=your-flask-secret-key-change-this-xyz789

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Edge Node Configuration
EDGE_SSH_USER=root
EDGE_SSH_KEY=/app/ansible/keys/xencdn-ed25519
EDGE_DEFAULT_REGION=nyc1
EDGE_MAX_CLIENTS_PER_NODE=25

# BGP/Anycast Configuration (Optional - for BGP Mode)
BGP_ASN=your-bgp-asn-65000
BGP_IP_BLOCK=203.0.113.0/24
BGP_PEER_IP=your-bgp-peer-ip
BGP_ROUTER_ID=203.0.113.1

# Edge Deployment Modes
EDGE_MODE=single_ip  # single_ip or bgp_anycast

# Security Configuration
ALLOWED_ORIGINS=https://admin.xencdn.com,https://client.xencdn.com,https://isp.xencdn.com
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=100

# Email Configuration for Reports
SMTP_SERVER=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM=reports@xencdn.com

# Encryption Configuration
FERNET_KEY=your-fernet-encryption-key-for-cpanel-passwords

# Monitoring Configuration (NO Prometheus/Grafana - native monitoring)
MONITORING_ENABLED=true
MONITORING_RETENTION_DAYS=90

# Auto-scaling Configuration (DISABLED - Manual edge addition only)
AUTO_SCALE_ENABLED=false
MANUAL_EDGE_ONLY=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_RETENTION_DAYS=7

# Business Configuration
CDN_COMPANY_NAME=Your Company Name
CDN_SUPPORT_EMAIL=support@xencdn.com
CDN_BILLING_EMAIL=billing@xencdn.com

# White-labeling Configuration
WHITE_LABEL_ENABLED=true
WHITE_LABEL_LOGO_URL=https://cdn.yourcompany.com/logo.png
WHITE_LABEL_COMPANY_NAME=Your CDN Company