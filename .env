# Cachenet CDN Platform Environment Configuration
# Replace all placeholder values with your actual credentials

# Database Configuration
DATABASE_URL=postgresql://cachenet:secure_password_123@db:5432/cachenet
POSTGRES_DB=cachenet
POSTGRES_USER=cachenet
POSTGRES_PASSWORD=secure_password_123

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# JWT Secret Key - Generate a new one for production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production-xyz789

# PowerDNS Configuration
PDNS_API_KEY=your-powerdns-api-key-abc123456789
PDNS_API_URL=http://powerdns:8081/api/v1/servers/localhost

# MinIO S3 Configuration
MINIO_ROOT_USER=cachenet-admin
MINIO_ROOT_PASSWORD=cachenet-secure-password-456
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=cachenet-ssl-certs

# Cloud Provider APIs for Auto-scaling
DIGITALOCEAN_API_TOKEN=your-digitalocean-api-token-dop_v1_abc123
LINODE_API_TOKEN=your-linode-api-token-lish_abc123
VULTR_API_KEY=your-vultr-api-key-vultr_abc123
HETZNER_API_TOKEN=your-hetzner-api-token-hetzner_abc123

# MaxMind GeoIP Database
MAXMIND_LICENSE_KEY=your-maxmind-license-key-abc123
MAXMIND_ACCOUNT_ID=your-maxmind-account-id-123456

# ACME.sh Configuration
ACME_EMAIL=admin@yourdomain.com
ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Monitoring Configuration
GRAFANA_ADMIN_PASSWORD=admin-secure-password-789
PROMETHEUS_RETENTION=30d

# Edge Node Configuration
EDGE_SSH_USER=root
EDGE_SSH_KEY=/app/ansible/keys/cachenet-ed25519
EDGE_DEFAULT_REGION=nyc1
EDGE_MAX_CLIENTS_PER_NODE=25

# CDN Configuration
CDN_DOMAIN=cdn.yourdomain.com
API_DOMAIN=api.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
CLIENT_DOMAIN=client.yourdomain.com

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=your-flask-secret-key-change-this-xyz789

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Auto-scaling Configuration
AUTO_SCALE_ENABLED=true
AUTO_SCALE_CHECK_INTERVAL=300
AUTO_SCALE_MIN_NODES=2
AUTO_SCALE_MAX_NODES=50

# Security Configuration
ALLOWED_ORIGINS=https://admin.yourdomain.com,https://client.yourdomain.com
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=100

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_RETENTION_DAYS=7