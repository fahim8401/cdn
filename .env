# XenCDN v8.1 - Enterprise CDN Platform Environment Configuration
# Replace all placeholder values with your actual credentials

# Database Configuration
DATABASE_URL=postgresql://xencdn:xencdn_secure_password_123@db:5432/xencdn
POSTGRES_DB=xencdn
POSTGRES_USER=xencdn
POSTGRES_PASSWORD=xencdn_secure_password_123

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# JWT Secret Key - Generate a new one for production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production-xyz789abc

# PowerDNS Configuration
PDNS_API_KEY=your-powerdns-api-key-abc123456789
PDNS_API_URL=http://powerdns:8081/api/v1/servers/localhost

# MinIO S3 Configuration
MINIO_ROOT_USER=xencdn-admin
MINIO_ROOT_PASSWORD=xencdn-secure-password-456
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=xencdn-storage

# Cloud Provider APIs for Auto-scaling
DIGITALOCEAN_API_TOKEN=your-digitalocean-api-token-dop_v1_abc123
LINODE_API_TOKEN=your-linode-api-token-lish_abc123
VULTR_API_KEY=your-vultr-api-key-vultr_abc123
HETZNER_API_TOKEN=your-hetzner-api-token-hetzner_abc123

# MaxMind GeoIP Database
MAXMIND_LICENSE_KEY=your-maxmind-license-key-abc123
MAXMIND_ACCOUNT_ID=your-maxmind-account-id-123456

# ACME.sh Configuration
ACME_EMAIL=admin@cdn.yourcompany.com
ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Email Configuration for Reports and Notifications
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key-here
SMTP_FROM=noreply@cdn.yourcompany.com

# Encryption Key for Sensitive Data (cPanel passwords, etc.)
ENCRYPTION_KEY=your-fernet-encryption-key-32-characters-long-abc123

# Domain Configuration
HOMEPAGE_DOMAIN=xencdn.com
CLIENT_PORTAL_DOMAIN=client.xencdn.com
ISP_PORTAL_DOMAIN=isp.xencdn.com
ADMIN_DOMAIN=admin.xencdn.com
SPEED_TEST_DOMAIN=speedtest.xencdn.com
CDN_DOMAIN=cdn.yourcompany.com
API_DOMAIN=api.xencdn.com

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=your-flask-secret-key-change-this-xyz789

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# BGP Configuration (optional - for BGP Anycast Mode)
BGP_ASN=64512
BGP_IP_BLOCK=203.0.113.0/24
BGP_ANYCAST_IP=203.0.113.10
BGP_PEER_IP=your-peer-router-ip

# Edge Node Configuration
EDGE_SSH_USER=root
EDGE_SSH_KEY=/app/ansible/keys/xencdn-ed25519
EDGE_DEFAULT_REGION=nyc1
EDGE_MAX_CLIENTS_PER_NODE=25
EDGE_DEPLOYMENT_MODE=single_ip  # single_ip or bgp_anycast

# Auto-scaling Configuration
AUTO_SCALE_ENABLED=false  # Manual edge node addition only
AUTO_SCALE_CHECK_INTERVAL=300
AUTO_SCALE_MIN_NODES=2
AUTO_SCALE_MAX_NODES=50

# Security Configuration
ALLOWED_ORIGINS=https://admin.xencdn.com,https://client.xencdn.com,https://isp.xencdn.com
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=100

# Monitoring Configuration (Native - No Prometheus/Grafana)
MONITORING_ENABLED=true
MONITORING_DATA_RETENTION_DAYS=90

# SSL Configuration
SSL_AUTO_RENEWAL=true
SSL_RENEWAL_DAYS_BEFORE=30

# White Label Configuration
WHITE_LABEL_ENABLED=true
WHITE_LABEL_COMPANY_NAME=YourCompany
WHITE_LABEL_LOGO_URL=https://cdn.yourcompany.com/logo.png

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_RETENTION_DAYS=7

# Speed Test Configuration
SPEED_TEST_ENABLED=true
SPEED_TEST_MAX_TESTS_PER_IP=10
SPEED_TEST_MAX_TESTS_PER_HOUR=100

# Client Portal Configuration
CLIENT_REGISTRATION_ENABLED=true
CLIENT_EMAIL_VERIFICATION=true
CLIENT_FREE_TIER_ENABLED=true
CLIENT_FREE_TIER_BANDWIDTH_GB=100

# ISP Portal Configuration
ISP_REGISTRATION_ENABLED=true
ISP_AUTO_APPROVAL=false
ISP_PEERING_METHODS=ixp,direct,gre_tunnel,hosted_node