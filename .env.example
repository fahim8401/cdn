# Cachenet CDN Platform Environment Configuration
# Copy this file to .env and configure all values before running install.sh

# Database Configuration
DATABASE_URL=postgresql://cachenet:CHANGE_ME_DB_PASSWORD@db:5432/cachenet
POSTGRES_DB=cachenet
POSTGRES_USER=cachenet
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# JWT Secret Key - Will be auto-generated during installation
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET

# PowerDNS Configuration
PDNS_API_KEY=CHANGE_ME_PDNS_API_KEY
PDNS_API_URL=http://powerdns:8081/api/v1/servers/localhost

# MinIO S3 Configuration
MINIO_ROOT_USER=cachenet-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=cachenet-ssl-certs

# Cloud Provider APIs for Auto-scaling (Optional)
DIGITALOCEAN_API_TOKEN=CHANGE_ME_DO_TOKEN
LINODE_API_TOKEN=CHANGE_ME_LINODE_TOKEN
VULTR_API_KEY=CHANGE_ME_VULTR_KEY
HETZNER_API_TOKEN=CHANGE_ME_HETZNER_TOKEN

# MaxMind GeoIP Database (Optional)
MAXMIND_LICENSE_KEY=CHANGE_ME_MAXMIND_KEY
MAXMIND_ACCOUNT_ID=CHANGE_ME_MAXMIND_ID

# ACME.sh Configuration
ACME_EMAIL=admin@yourdomain.com
ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Monitoring Configuration
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
PROMETHEUS_RETENTION=30d

# Edge Node Configuration
EDGE_SSH_USER=root
EDGE_SSH_KEY=/app/ansible/keys/cachenet-ed25519
EDGE_DEFAULT_REGION=nyc1
EDGE_MAX_CLIENTS_PER_NODE=25

# CDN Configuration - REQUIRED
CDN_DOMAIN=CHANGE_ME_CDN_DOMAIN
API_DOMAIN=CHANGE_ME_API_DOMAIN
ADMIN_DOMAIN=CHANGE_ME_ADMIN_DOMAIN
CLIENT_DOMAIN=CHANGE_ME_CLIENT_DOMAIN

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=CHANGE_ME_FLASK_SECRET

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Auto-scaling Configuration
AUTO_SCALE_ENABLED=true
AUTO_SCALE_CHECK_INTERVAL=300
AUTO_SCALE_MIN_NODES=2
AUTO_SCALE_MAX_NODES=50

# Security Configuration
ALLOWED_ORIGINS=https://CHANGE_ME_ADMIN_DOMAIN,https://CHANGE_ME_CLIENT_DOMAIN
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=100

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_RETENTION_DAYS=7

# Admin User Configuration (Used during installation)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_FIRST_NAME=Administrator
ADMIN_LAST_NAME=User